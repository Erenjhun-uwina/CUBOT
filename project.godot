; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[addons]

universal_fade/patterns_directory="res://addons/UniversalFade/Patterns"

[application]

config/name="CUBOT"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
boot_splash/image="uid://dyup6wxpl6mh0"
config/icon="uid://dyup6wxpl6mh0"
config/windows_native_icon="res://assets/img/icon.ico"

[debug]

file_logging/enable_file_logging=true
file_logging/log_path="user://logs/CUBOT.log"

[display]

window/size/mode=4
window/stretch/mode="viewport"

[editor]

movie_writer/movie_file="D:/dino_run_tut-main/death ani.avi"

[editor_plugins]

enabled=PackedStringArray("res://addons/ScriptEditorQoL/plugin.cfg")

[global_group]

obstacle=""

[layer_names]

2d_physics/layer_1="player"
2d_physics/layer_2="corpse"
2d_physics/layer_5="ground"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
